From 5fa39beef6234ccb08ccd64244bcd1a399ac1381 Mon Sep 17 00:00:00 2001
From: Robert Popa <robert.popa@geseidl.ro>
Date: Thu, 8 Oct 2026 01:44:56 +0300
Subject: [PATCH] fix(dns): use native syslog for NSD

---
 setup/dns.sh                     | 5 +++--
 tests/test_nsd_control_config.py | 2 ++
 2 files changed, 5 insertions(+), 2 deletions(-)

diff --git a/setup/dns.sh b/setup/dns.sh
index 37fdf1a..022e08b 100755
--- a/setup/dns.sh
+++ b/setup/dns.sh
@@ -22,7 +22,9 @@ cat > /etc/nsd/nsd.conf << EOF;
 # Do not edit. Overwritten by Mail-in-a-Box setup.
 server:
   hide-version: yes
-  logfile: "/var/log/nsd.log"
+  # Use syslog/journal; the hardened service cannot write arbitrary /var/log files.
+  logfile: ""
+  log-only-syslog: yes
 
   # identify the server (CH TXT ID.SERVER entry).
   identity: ""
@@ -158,4 +160,3 @@ chmod +x /etc/cron.daily/mailinabox-dnssec
 # Permit DNS queries on TCP/UDP in the firewall.
 
 ufw_allow domain
-
diff --git a/tests/test_nsd_control_config.py b/tests/test_nsd_control_config.py
index cce027c..61999c2 100644
--- a/tests/test_nsd_control_config.py
+++ b/tests/test_nsd_control_config.py
@@ -27,6 +27,8 @@ class NsdControlConfigurationTests(unittest.TestCase):
                 return shlex.split(result)
             self.assertEqual(option('control-enable'), ['yes'])
             self.assertEqual(option('control-interface'), ['127.0.0.1'])
+            self.assertEqual(option('logfile'), [])
+            self.assertEqual(option('log-only-syslog'), ['yes'])
 
 
 if __name__ == '__main__':
-- 
2.55.0.windows.5

