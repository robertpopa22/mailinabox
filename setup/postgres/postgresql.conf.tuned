# Mail server PostgreSQL 19 tuning — 45GB RAM / 44 cores
# Installed as /etc/postgresql/19/main/conf.d/99-mailinabox-tuned.conf

# Network
listen_addresses = '<server-lan-ip>, 127.0.0.1'   # replace <server-lan-ip> before use
port = 5432

# Memory
shared_buffers = 12GB
effective_cache_size = 32GB
work_mem = 256MB
maintenance_work_mem = 4GB
huge_pages = try

# Parallel
max_connections = 100
max_worker_processes = 44
max_parallel_workers = 40
max_parallel_workers_per_gather = 10
max_parallel_maintenance_workers = 8

# Storage / IO (SSD)
random_page_cost = 1.1
effective_io_concurrency = 200

# WAL / checkpoints
# Rare checkpoints write far fewer full-page images for this index workload.
# Cost: crash recovery may replay up to max_wal_size of WAL; size the disk for it.
wal_compression = zstd
checkpoint_completion_target = 0.9
checkpoint_timeout = 1d
max_wal_size = 32GB
min_wal_size = 2GB

# Logging
log_min_duration_statement = 1000
log_checkpoints = on
log_connections = on
log_disconnections = on
log_lock_waits = on
log_temp_files = 16MB
log_line_prefix = '%t [%p] %u@%d '

# Autovacuum
autovacuum_max_workers = 4
autovacuum_naptime = 30s
