[Unit]
Description=Geseidl DMARC aggregate report monitor
After=dovecot.service postfix.service
Wants=dovecot.service postfix.service

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/geseidl-dmarc-alerts
User=root
Group=root
UMask=0077
Nice=10
# doveadm starts as root and must setuid to the mailbox owner (mail, uid 8).
PrivateDevices=true
PrivateTmp=true
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictSUIDSGID=true
